# ============================================
# Llama Nexus configuration
# ============================================
# Copy this file to .env and adjust. Everything below is optional — the
# installers (install.sh / install.ps1) generate a working .env for you.
# See docs/user/INSTALL.md for details.

# Inference API key (llama.cpp / vLLM / NInfer + the web UI proxy).
# Generate your own: openssl rand -hex 16
API_KEY=placeholder-api-key

# Optional: HuggingFace token — only needed for gated models.
# Create one at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Prebuilt llama.cpp image tier (used with docker-compose.prebuilt.yml).
# Leave empty to let install.sh pick. Options:
#   ghcr.io/aleckarfonta/llama-nexus-llamacpp:cpu       (no NVIDIA GPU)
#   ghcr.io/aleckarfonta/llama-nexus-llamacpp:cuda-86   (RTX 30xx / A-series)
#   ghcr.io/aleckarfonta/llama-nexus-llamacpp:cuda-89   (RTX 40xx / L40S)
#   ghcr.io/aleckarfonta/llama-nexus-llamacpp:cuda-120  (RTX 50xx Blackwell)
LLAMACPP_DOCKER_IMAGE=

# Network binding: default 127.0.0.1 (local only). Set 0.0.0.0 to expose the
# UI/API on your LAN — pair with MANAGEMENT_AUTH_TOKEN below.
BIND_HOST=127.0.0.1

# Optional management-API token (recommended when exposing on LAN).
# Required for all /api/v1 routes as `Authorization: Bearer <token>`.
MANAGEMENT_AUTH_TOKEN=

# ---- Model defaults (override per-deploy in the web UI) ----
MODEL_NAME=Qwen3-4B-Instruct
MODEL_VARIANT=Q4_K_M
MODEL_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
CONTEXT_SIZE=8192
THREADS=0

# llama.cpp Docker build (source-build path only; prebuilt images ignore this):
# CMake SM version — run scripts/detect-cuda-arch.sh to detect. 86 = RTX 30xx,
# 89 = RTX 40xx, 120 = RTX 50xx. Do not use "native" (build container has no GPU).
# CUDA_ARCH=86

# Embedding service key (separate from inference API_KEY)
EMBEDDING_SERVICE_API_KEY=llamacpp-embed

# RAG context expansion (neighboring chunks included in results)
RAG_CONTEXT_NEIGHBORS_BEFORE=1
RAG_CONTEXT_NEIGHBORS_AFTER=1

# ============================================
# GraphRAG (optional)
# ============================================
GRAPHRAG_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# [2026-10-16] | INFO | ENV.NEO4J | required by compose (no default); installers
# generate a random value — replace 'changeme' with your own secret
NEO4J_PASSWORD=changeme

# Helper service URLs (auto-discovered in Docker when profiles are enabled)
# NER_API_URL=http://graphrag-ner:8001
# REL_API_URL=http://graphrag-rel:8002
# CODE_RAG_URL=http://graphrag-code:8000

# Anthropic API (optional, advanced reasoning features)
# ANTHROPIC_API_KEY=your_key_here
